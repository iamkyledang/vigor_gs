+template<int NUM_CHANNELS>
+void BACKWARD::render(
+	const dim3 grid, const dim3 block,
+	const uint2* ranges,
+	const uint32_t* point_list,
+	int W, int H,
+	float focal_x, float focal_y,
+	const float* bg_color,
+	const float2* means2D,
+	const float4* normal_opacity,
+	const float* transMats,
+	const float* colors,
+	const float* extras,
+	const float* depths,
+	const float* final_Ts,
+	const uint32_t* n_contrib,
+	const float* dL_dcolor_pixels,
+	const float* dL_dextra_pixels,
+	const float* dL_depths,
+	float * dL_dtransMat,
+	float3* dL_dmean2D,
+	float* dL_dnormal3D,
+	float* dL_dopacity,
+	float* dL_dcolor,
+	float* dL_dextras)
+{
+	renderCUDA<NUM_CHANNELS> << <grid, block >> >(
+		ranges,
+		point_list,
+		W, H,
+		focal_x, focal_y,
+		bg_color,
+		means2D,
+		normal_opacity,
+		transMats,
+		colors,
+		extras,
+		depths,
+		final_Ts,
+		n_contrib,
+		dL_dcolor_pixels,
+		dL_dextra_pixels,
+		dL_depths,
+		dL_dtransMat,
+		dL_dmean2D,
+		dL_dnormal3D,
+		dL_dopacity,
+		dL_dcolor,
+		dL_dextras
+		);
+}
