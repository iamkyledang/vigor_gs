+#define X(N) \
+	template void BACKWARD::preprocess<N>( \
+		int P, int D, int M, \
+		const float3* means3D, \
+		const int* radii, \
+		const float* shs, \
+		const bool* clamped, \
+		const glm::vec2* scales, \
+		const glm::vec4* rotations, \
+		const float scale_modifier, \
+		const float* transMats, \
+		const float* viewmatrix, \
+		const float* projmatrix, \
